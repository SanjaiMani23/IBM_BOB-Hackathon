# ─────────────────────────────────────────────
# DevFlow CodeLens — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=

# ── Security ──────────────────────────────────
# Long random string used to sign JWT tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── GitHub ────────────────────────────────────
# Personal access token with repo + read:user scopes.
GITHUB_TOKEN=
# OAuth app credentials (for user-facing GitHub login).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Jira ──────────────────────────────────────
# Base URL of your Atlassian instance, e.g. https://yourorg.atlassian.net
JIRA_URL=
# Email address associated with the Jira API token.
JIRA_EMAIL=
# Atlassian API token (not your account password).
JIRA_TOKEN=

# ── IBM watsonx.ai ────────────────────────────
# IBM Cloud API key — generate at https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=
# watsonx.ai project ID — found in your watsonx.ai project settings.
WATSONX_PROJECT_ID=
# Regional endpoint for watsonx.ai inference.
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Foundation model to use for all AI features.
WATSONX_MODEL_ID=ibm/granite-34b-code-instruct

# ── Redis (optional — for response caching) ───
# Leave empty to disable caching.
REDIS_URL=

# ── Application ───────────────────────────────
# Full origin of the frontend, used for CORS.
FRONTEND_URL=http://localhost:5173
# Set to "production" to disable debug output and stack traces.
ENVIRONMENT=development
